# ===========================================================
# CONFIGURACIÓN DEL SERVIDOR
# ===========================================================
PORT=3000
NODE_ENV=development

# ===========================================================
# SHOPIFY API
# ===========================================================
# Obtén estas credenciales en: Shopify Admin > Settings > Apps and sales channels > Develop apps
SHOPIFY_STORE_URL=tu-tienda.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-01
SHOPIFY_WEBHOOK_SECRET=tu_webhook_secret_de_shopify

# ===========================================================
# BASE DE DATOS POSTGRESQL (Althen Hosting)
# ===========================================================
# Althen te proporcionará estos datos al crear tu base de datos PostgreSQL
DB_HOST=tu-host-althen.com
DB_PORT=5432
DB_NAME=nombre_de_tu_base_datos
DB_USER=tu_usuario_postgresql
DB_PASSWORD=tu_password_postgresql
DB_SSL=true

# ===========================================================
# JustTCG API
# ===========================================================
# Obtén tu API Key en: https://justtcg.com/dashboard/plans
JUSTTCG_API_KEY=tu_justtcg_key_aqui
JUSTTCG_BASE_URL=https://api.justtcg.com/v1
JUSTTCG_GAME=mtg

# ===========================================================
# API DE TIPO DE CAMBIO (Opcional)
# ===========================================================
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/
EXCHANGE_RATE_API_KEY=

# ===========================================================
# CONFIGURACIÓN DE PRECIOS
# ===========================================================
# Fuente de precios: average (promedio CardMarket + TCGPlayer) | CardMarket | TCGPlayer
PRICE_SOURCE=average

# ===========================================================
# CONFIGURACIÓN DE NEGOCIO
# ===========================================================
# Porcentaje mínimo de diferencia de precio para generar alerta (3%)
PRICE_THRESHOLD_PERCENTAGE=3

# Frecuencia de sincronización en horas (24 = una vez al día)
SYNC_FREQUENCY_HOURS=24

# Margen del tipo de cambio (1.1 = 10% de markup)
EXCHANGE_RATE_MARGIN=1.1

# ===========================================================
# JUEGOS SOPORTADOS
# ===========================================================
SUPPORTED_GAMES=mtg,magic-the-gathering,pokemon,yugioh,disney-lorcana,one-piece-card-game,digimon-card-game,union-arena

# ===========================================================
# CICLO AUTOMÁTICO SELLADOS (RECONCILE + REFRESH)
# ===========================================================
ENABLE_SEALED_SYNC_CRON=false
SEALED_SYNC_FREQUENCY_HOURS=24
SEALED_SYNC_RUN_ON_STARTUP=false
SEALED_SYNC_VERBOSE=false
SEALED_SYNC_GAME=

# Reconciliación
SEALED_RECONCILE_LIMIT=100
SEALED_MIN_CONFIDENCE=70
SEALED_ONLY_IN_STOCK=true
SEALED_ONLY_UNMAPPED=true
SEALED_SKU_STRICT=true

# Refresh de diferencias
SEALED_REFRESH_LIMIT=300