# ==================================================
# CONFIGURACIÓN DEL SERVIDOR
# ==================================================
PORT=3000
NODE_ENV=development
# ==================================================
# BASE DE DATOS POSTGRESQL (RENDER.COM)
# ==================================================
DB_HOST=tu_host.render.com 
DB_PORT=5432
DB_NAME=price_radar_tcg_db
DB_USER=tu_usuario
DB_PASSWORD=tu_password_super_secreto
DB_DIALECT=postgres

# ==================================================
# SHOPIFY API
# ==================================================
# Tu tienda: http://tu-tienda.myshopify.com
SHOPIFY_STORE=tu-tienda.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-01

# ==================================================
# TCGGO API (VIA RAPIDAPI)
# ==================================================
RAPIDAPI_KEY=tu-api-key-secreta-aqui
RAPIDAPI_HOST=tu-host-de-rapid-api
RAPIDAPI_BASE_URL=url-de-rapid-api

# Exchange Rate (Usando el endpoint de TCGGO)
# No se necesita una API externa para el exchange rate
# EXCHANGE_RATE_API_URL=https://cardmarket-api-tcg.xxxxxxxxxxxxxxx

# CONFIGURACIÓN DE PRECIOS
# Usaremos el promedio entre CardMarket (EUR) y TCGPlayer (USD)
PRICE_SOURCE=average
# Opciones: average | CardMarket | TCGPlayer

# ==================================================
# API DE TIPO DE CAMBIO
# ==================================================
# Opciones: exchangerate-api.com, fixer.io, etc
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/
EXCHANGE_RATE_API_KEY=tu_key_opcional

# ==================================================
# CONFIGURACIÓN DE NEGOCIO
# ==================================================
# Umbral de diferencia de precio para alertar (en porcentaje)
PRICE_THRESHOLD_PERCENTAGE=5

# Intervalo de actualización automática (en horas)
UPDATE_INTERVAL_HOURS=24

# Márgen adicional sobre tipo de cambio (multiplicador)
# Ejemplo: 1.15 = Agregar 15% al precio del mercado
EXCHANGE_RATE_MARGIN=1.1

# ==================================================
# JUEGOS SOPORTADOS
# ==================================================
SUPPORTED_GAMES=magic,pokemon,riftbound,onepiece,gundam